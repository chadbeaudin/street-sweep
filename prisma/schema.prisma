generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OsmCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())

  @@map("osm_cache")
}

model GeocodeCache {
  key       String   @id
  result    Json
  fetchedAt DateTime @default(now())

  @@map("geocode_cache")
}

model RiddenRoadsCache {
  athleteId   String   @id
  roads       Json
  version     Int      @default(1)
  refreshedAt DateTime @default(now())

  @@map("ridden_roads_cache")
}

model Route {
  id          String            @id @default(cuid())
  name        String?
  coordinates Json
  distance    Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  collections CollectionRoute[]

  @@map("routes")
}

model Collection {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  routes    CollectionRoute[]

  @@map("collections")
}

model CollectionRoute {
  collectionId String
  routeId      String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  route        Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([collectionId, routeId])
  @@map("collection_routes")
}

model StatsCache {
  athleteId   String   @id
  stats       Json
  refreshedAt DateTime @default(now())

  @@map("stats_cache")
}

model StravaActivityCache {
  athleteId  String   @id
  activities Json
  syncedAt   DateTime @default(now())

  @@map("strava_activity_cache")
}

// Full-resolution polyline per activity, backfilled gradually and cached
// permanently (a completed ride's GPS trace never changes, so this never
// expires). Fixes ridden-road matching against Strava's summary_polyline,
// which is decimated for map thumbnails and can flatten out tight loops/
// curves entirely -- see the gated-community/#82-adjacent routing work.
// athleteId is indexed (not the key) so a rider's rows can be looked up/
// purged by identity even though activityId alone already uniquely
// determines the owner on Strava's side.
model StravaActivityDetail {
  activityId String   @id
  athleteId  String
  polyline   String
  fetchedAt  DateTime @default(now())

  @@index([athleteId])
  @@map("strava_activity_detail")
}

model FtpReadingCache {
  athleteId   String   @id
  readings    Json
  refreshedAt DateTime @default(now())

  @@map("ftp_reading_cache")
}

// Standard Auth.js/NextAuth Prisma-adapter schema (#87), plus athleteId on
// User: captured from the Strava provider profile at sign-in, so a signed-in
// user's rows can be linked to the existing athleteId-keyed caches
// (StravaActivityCache, StravaActivityDetail, etc.) without migrating those
// tables' primary keys.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  athleteId     String?   @unique
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
