generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OsmCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())

  @@map("osm_cache")
}

model GeocodeCache {
  key       String   @id
  result    Json
  fetchedAt DateTime @default(now())

  @@map("geocode_cache")
}

model RiddenRoadsCache {
  athleteId   String   @id
  roads       Json
  version     Int      @default(1)
  refreshedAt DateTime @default(now())

  @@map("ridden_roads_cache")
}

model Route {
  id          String            @id @default(cuid())
  name        String?
  coordinates Json
  distance    Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  collections CollectionRoute[]

  @@map("routes")
}

model Collection {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  routes    CollectionRoute[]

  @@map("collections")
}

model CollectionRoute {
  collectionId String
  routeId      String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  route        Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([collectionId, routeId])
  @@map("collection_routes")
}

model StatsCache {
  athleteId   String   @id
  stats       Json
  refreshedAt DateTime @default(now())

  @@map("stats_cache")
}

model StravaActivityCache {
  athleteId  String   @id
  activities Json
  syncedAt   DateTime @default(now())

  @@map("strava_activity_cache")
}

model FtpReadingCache {
  athleteId   String   @id
  readings    Json
  refreshedAt DateTime @default(now())

  @@map("ftp_reading_cache")
}
